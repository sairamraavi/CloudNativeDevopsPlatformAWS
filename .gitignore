
# ============================================================
# TERRAFORM
# ============================================================

# Local Terraform working directories
**/.terraform/

# Terraform state
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform saved plans
*.tfplan
*.tfplan.*
tfplan
tfplan.*
planout
planout.*
*.plan

# Terraform variable files
*.tfvars
*.tfvars.json

# Allow safe example configurations
!*.tfvars.example
!*.tfvars.json.example

# Terraform overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI configuration
.terraformrc
terraform.rc

# IMPORTANT: Keep .terraform.lock.hcl tracked


# ============================================================
# AWS CLI / LOCAL AWS FILES
# ============================================================

# Downloaded AWS CLI installation
/aws/
/awscliv2.zip

# Local AWS credentials and configuration
.aws/

# Generated AWS audit archives
/checks/**/*.zip


