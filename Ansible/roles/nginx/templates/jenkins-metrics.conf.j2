server {
    listen {{ ansible_facts['default_ipv4']['address'] }}:8082;
    server_name _;
    server_tokens off;

    location = /prometheus/ {
        limit_except GET {
            deny all;
        }

        proxy_pass http://127.0.0.1:8080/prometheus/;
        proxy_set_header Host localhost;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }

    location / {
        return 404;
    }
}
