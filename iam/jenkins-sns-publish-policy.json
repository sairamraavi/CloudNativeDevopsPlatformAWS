{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishStreamingAppAlerts",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:*:*:streamingapp-alerts",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "${aws:PrincipalAccount}",
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    }
  ]
}
