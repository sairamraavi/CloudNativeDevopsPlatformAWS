
image:
  registry: 529976312668.dkr.ecr.ap-southeast-2.amazonaws.com
  tag: REPLACE_WITH_STAGING_IMAGE_TAG
  pullPolicy: IfNotPresent

frontend:
  repository: streamingapp-capstone-frontend
  tag: REPLACE_WITH_STAGING_IMAGE_TAG
  replicas: 1
  port: 80
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 128Mi

backend:
  replicas: 1
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 300m
      memory: 256Mi

services:
  auth:
    repository: streamingapp-capstone-auth
    serviceAccountName: streamingapp-auth
    roleArn: ""
    port: 3001
    healthPath: /health
  streaming:
    repository: streamingapp-capstone-streaming
    serviceAccountName: streamingapp-streaming
    roleArn: REPLACE_WITH_STREAMING_MEDIA_ROLE_ARN
    port: 3002
    healthPath: /api/health
  admin:
    repository: streamingapp-capstone-admin
    serviceAccountName: streamingapp-admin
    roleArn: REPLACE_WITH_ADMIN_MEDIA_ROLE_ARN
    port: 3003
    healthPath: /api/health
  chat:
    repository: streamingapp-capstone-chat
    serviceAccountName: streamingapp-chat
    roleArn: ""
    port: 3004
    healthPath: /api/health

mongodb:
  enabled: false
  image: mongo:6
  port: 27017
  storageSize: 1Gi
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: 300m
      memory: 512Mi

app:
  secretName: streamingapp-application
  clientUrls: ""
  streamingPublicUrl: ""
  awsRegion: ap-southeast-2
  s3Bucket: ""

ingress:
  enabled: false
  className: alb
  host: ""
  certificateArn: ""

autoscaling:
  enabled: true
  workloads:
    - auth
    - streaming
    - admin
    - frontend
  minReplicas: 1
  maxReplicas: 2
  targetCPUUtilizationPercentage: 70

awsRegion: ap-southeast-2

secretReader:
  serviceAccountName: streamingapp-secret-reader
  roleArn: ""

remoteSecretName: streamingapp-capstone/staging/application
targetSecretName: streamingapp-application
refreshInterval: 1h