{
  "agent": {
    "region": "ap-south-1",
    "run_as_user": "root"
  },
  "logs": {
    "force_flush_interval": 5,
    "logs_collected": {
      "journald": {
        "collect_list": [
          {
            "units": ["jenkins.service"],
            "log_group_name": "/streamingapp-capstone/dev/jenkins",
            "log_stream_name": "{instance_id}/jenkins-service"
          }
        ]
      }
    }
  }
}
